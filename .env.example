# Local defaults. Never commit real keys; hosted setup is in the deployment runbook.
APP_ENV=local
NEXT_PUBLIC_APP_ENV=local
SITE_URL=http://127.0.0.1:3000

# Fill from your disposable LOCAL Supabase instance only when it is running.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Hosted environments require explicit identity to enforce environment separation.
SUPABASE_PROJECT_REF=
PRODUCTION_SUPABASE_PROJECT_REF=
PRODUCTION_SITE_URL=

# disabled by default; test is allowed only in local/staging. Live is rejected.
CHECKOUT_MODE=disabled
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Optional approved policies. No shipping, date or return promise is inferred.
# {"delivery":{"summary":"...","url":"https://..."},"returns":{"summary":"...","url":"https://..."}}
SHOPPING_POLICIES_JSON=
