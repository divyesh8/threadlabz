# ==============================================================================
# THREADLAB — Environment Configuration Guide
# ==============================================================================

# Next.js Application URL
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Razorpay Payment Gateway (Test Mode / Sandbox)
# Get keys at: https://dashboard.razorpay.com/app/keys
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_threadlab_demo
RAZORPAY_KEY_SECRET=rzp_secret_key_demo_only
RAZORPAY_WEBHOOK_SECRET=rzp_webhook_secret_key

# Supabase Authentication & PostgreSQL Database
# Get credentials at: https://supabase.com/dashboard/project/_/settings/api
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# PostgreSQL Direct Connection String (for Prisma or direct pg pools)
DATABASE_URL=postgresql://postgres:password@db.your-project.supabase.co:5432/postgres

# Storage Bucket (for user uploaded custom artwork / design exports)
NEXT_PUBLIC_SUPABASE_STORAGE_BUCKET=threadlab-custom-assets

# Store Contact & Brand Configuration
NEXT_PUBLIC_STORE_NAME="THREADLAB"
NEXT_PUBLIC_STORE_TAGLINE="Your Style. Your Canvas."
NEXT_PUBLIC_SUPPORT_EMAIL="support@threadlab.in"
NEXT_PUBLIC_SUPPORT_PHONE="+91 98765 43210"
