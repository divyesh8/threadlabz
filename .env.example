# ThreadLabz Environment Configuration Template
# Copy to .env.local for local development. Never commit real keys or secrets to git.

# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_pub_...
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_anon_...
SUPABASE_SERVICE_ROLE_KEY=sb_sec_...

# Store Domain
SITE_URL=http://localhost:3000

# Razorpay Payment Gateway (Test mode: rzp_test_... / Live mode: rzp_live_...)
RAZORPAY_KEY_ID=rzp_test_...
RAZORPAY_KEY_SECRET=...
RAZORPAY_WEBHOOK_SECRET=...
